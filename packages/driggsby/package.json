{
  "name": "driggsby",
  "version": "0.2.4",
  "description": "Set up and build on Driggsby, the MCP server for personal finance.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driggsby/driggsby.git"
  },
  "homepage": "https://driggsby.com",
  "type": "module",
  "bin": {
    "driggsby": "bin/driggsby.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --prefix ../sdk && tsc -p ../deploy/tsconfig.build.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@driggsby/deploy": "0.2.4",
    "@driggsby/sdk": "0.2.4"
  }
}
