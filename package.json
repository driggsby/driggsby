{
  "name": "@driggsby/workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint packages scripts --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.2.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1"
  },
  "engines": {
    "node": ">=24"
  }
}
